# Copy to .env for local dev. On Railway, set these as service variables.

# Railway injects this automatically when you attach a Postgres service.
DATABASE_URL=postgres://user:pass@host:5432/railway

# Generate all three with: npm run hash-password -- 'your-password'
ADMIN_PASSWORD_HASH=
SESSION_SECRET=
# 32 random bytes, base64. Decrypts every stored credential — losing it means
# reconnecting every account.
ENCRYPTION_KEY=

# Hard safety override. While this is anything other than "false", no connector
# can post for real, regardless of the dashboard toggle. Remove it (or set it to
# false) only when you're ready to publish.
DRY_RUN=true

# Optional, used for absolute links.
APP_URL=https://your-app.up.railway.app
