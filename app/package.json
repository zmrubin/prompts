{
  "name": "pr-agent-dashboard",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "tsx src/db/seed.ts && next dev",
    "build": "tsx src/db/seed.ts && next build",
    "start": "next start",
    "lint": "next lint",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=.env src/db/migrate.ts",
    "db:seed": "tsx --env-file-if-exists=.env src/db/seed.ts",
    "typecheck": "tsc --noEmit",
    "import": "tsx src/scripts/import.ts",
    "channels": "tsx src/scripts/channels-brief.ts",
    "db:setup": "tsx src/db/seed.ts",
    "setup": "tsx src/scripts/setup.ts",
    "mcp": "tsx src/mcp/server.ts",
    "refresh": "tsx src/scripts/refresh-metrics.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "better-sqlite3": "^13.0.2",
    "drizzle-orm": "^0.36.4",
    "next": "^15.1.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "server-only": "^0.0.1",
    "tsx": "^4.19.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "drizzle-kit": "^0.28.1",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=22"
  }
}
