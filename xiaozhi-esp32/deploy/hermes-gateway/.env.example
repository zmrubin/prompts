# ─── Hermes gateway deployment — environment ───────────────────────────────
# Copy to `.env`, fill in, then run ./render-config.sh && docker compose up -d
# `.env` is gitignored — secrets never get committed.

# Public hostname of THIS VPS (must resolve to it; Caddy gets a TLS cert for it).
# This is what the Watcher firmware's CONFIG_OTA_URL points at:
#   https://${GATEWAY_PUBLIC_HOST}/xiaozhi/ota/
GATEWAY_PUBLIC_HOST=hermes-gateway.example.com

# ─── External Hermes LLM (OpenAI-compatible endpoint) ──────────────────────
# Your Hermes instance — same VPS (http://hermes:8000/v1) or another host you
# control. Must speak the OpenAI /v1 API (vLLM, TGI, llama.cpp server, etc.).
HERMES_BASE_URL=http://hermes:8000/v1
HERMES_API_KEY=EMPTY

# Chat model id Hermes serves (e.g. hermes-3-llama-3.1-8b).
HERMES_CHAT_MODEL=hermes-3-llama-3.1-8b

# Vision model id for camera frames. Point at a vision-capable model on the
# same endpoint. If Hermes has no VLM, see README "Vision" for options.
HERMES_VISION_MODEL=hermes-3-llama-3.1-8b
